# --- Payment gateway (sandbox) ---
# Real sandbox values go in your local .env (NEVER commit .env).
# The sandbox base URL and the keys are provided in the challenge document.
GATEWAY_BASE_URL=https://<sandbox-base-url-from-the-brief>/v1
GATEWAY_PUBLIC_KEY=pub_stagtest_xxxxxxxxxxxxxxxxxxxxxxxx
GATEWAY_PRIVATE_KEY=prv_stagtest_xxxxxxxxxxxxxxxxxxxxxxxx
GATEWAY_INTEGRITY_SECRET=stagtest_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
GATEWAY_EVENTS_SECRET=stagtest_events_xxxxxxxxxxxxxxxxxxxxxxxx

# --- API ---
PORT=3000

# --- Database (PostgreSQL) ---
# Option A (local / docker-compose): discrete variables
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=payment_checkout
# Option B (managed Postgres in production): a single connection URL.
# When DATABASE_URL is set it takes precedence over the variables above.
# DB_SSL=false disables TLS (e.g. provider-internal connections).
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_SSL=true

# --- Gateway polling ---
GATEWAY_POLL_INTERVAL_MS=1500
GATEWAY_POLL_TIMEOUT_MS=60000
